configuration {
  font: "JetBrains Mono Nerd Font 12";
  terminal: "alacritty";

  combi {
    display-name: "󰍜";
  }

  drun {
    display-name: "󱓞";
  }

  run {
    display-name: "";
  }

  window {
    display-name: "";
  }

  microphone {
    display-name: "󰍬";
  }

  timeout {
    delay: 10;
    action: "kb-cancel";
  }

  filebrowser {
    display-name: "";
  }

  display-drun: "Application:";
  display-window: "Window:";
  display-filebrowser: "Files:";
  case-sensitive: false;
  sort: true;
  sorting-method: "fzf";
  modi: [
    "run",
    "drun",
    "window",
    "filebrowser",
    "ssh"
  ];
  show-icons: true;
  icon-theme: "Papirus-Dark";
}

window {
    /* properties for window widget */
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    font:                        "JetBrains Mono Nerd Font 12";
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    cursor:                      "default";
    background-color:            @bg;
}
